{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|run_command|shell",
        "hooks": [
          {
            "type": "command",
            "command": "atc hook PreToolUse"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "atc hook SessionEnd"
          }
        ]
      }
    ]
  }
}
